{
  "name": "py-runner-lab-editor",
  "private": true,
  "version": "0.1.0",
  "description": "CodeMirror bundle for py-runner lab (build-time only, no runtime deps)",
  "scripts": {
    "build": "esbuild editor.js --bundle --minify --format=esm --outfile=../py_runner/lab_static/js/vendor/cm.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
